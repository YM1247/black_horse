rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminSettingsExist() {
      return exists(/databases/$(database)/documents/settings/admin);
    }

    function adminSessionExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }

    function isAdmin() {
      return adminSettingsExist()
        && adminSessionExists()
        && get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.tokenHash
          == get(/databases/$(database)/documents/settings/admin).data.tokenHash;
    }

    match /settings/{documentId} {
      allow read, write: if false;
    }

    match /adminSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid && isAdmin();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && adminSettingsExist()
        && request.resource.data.keys().hasOnly(['tokenHash', 'createdAt', 'expiresAt'])
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.tokenHash
          == get(/databases/$(database)/documents/settings/admin).data.tokenHash;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /series/{seriesId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.revision == 1;
      allow update: if isAdmin()
        && (
          (!resource.data.keys().hasAny(['revision']) && request.resource.data.revision == 1)
          || (resource.data.keys().hasAny(['revision']) && request.resource.data.revision == resource.data.revision + 1)
        );

      match /deletionAudits/{logId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /publicSeries/{publicCode} {
      allow get: if resource.data.isPublic == true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /tournamentSummaries/{eventCode} {
      allow read, create, update, delete: if isAdmin();
    }

    match /systemMetadata/{documentId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /tournaments/{eventCode} {
      allow get: if isAdmin() || resource.data.isPublic == true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.revision == 0;
      allow update: if isAdmin()
        && (
          (!resource.data.keys().hasAny(['revision']) && request.resource.data.revision == 1)
          || (resource.data.keys().hasAny(['revision']) && request.resource.data.revision == resource.data.revision + 1)
        )
        && (
          !resource.data.keys().hasAny(['resultLocked'])
          || resource.data.resultLocked != true
          || (
            request.resource.data.phase == resource.data.phase
            && request.resource.data.players == resource.data.players
            && request.resource.data.rounds == resource.data.rounds
            && request.resource.data.currentRoundNum == resource.data.currentRoundNum
            && request.resource.data.judgeCount == resource.data.judgeCount
            && request.resource.data.doubleElimination == resource.data.doubleElimination
            && request.resource.data.runId == resource.data.runId
            && request.resource.data.runNumber == resource.data.runNumber
            && request.resource.data.currentVersion == resource.data.currentVersion
            && request.resource.data.get('currentVersionId', '') == resource.data.get('currentVersionId', '')
          )
          || (
            request.resource.data.currentVersion == resource.data.currentVersion + 1
            && request.resource.data.currentVersionId is string
            && existsAfter(/databases/$(database)/documents/tournaments/$(eventCode)/versions/$(request.resource.data.currentVersionId))
          )
          || (
            request.resource.data.phase == 'registration'
            && request.resource.data.resultLocked == false
            && request.resource.data.currentVersion == 0
            && request.resource.data.currentVersionId == ''
            && request.resource.data.runNumber == resource.data.runNumber + 1
            && request.resource.data.players.size() == 0
            && request.resource.data.rounds.size() == 0
          )
        );
      allow delete: if isAdmin();

      match /auditLogs/{logId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.version is int
          && request.resource.data.runId is string
          && getAfter(/databases/$(database)/documents/tournaments/$(eventCode)).data.currentVersionId == versionId
          && getAfter(/databases/$(database)/documents/tournaments/$(eventCode)).data.currentVersion == request.resource.data.version;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
