rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminSettingsExist() {
      return exists(/databases/$(database)/documents/settings/admin);
    }

    function adminSessionExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid));
    }

    function isAdmin() {
      return adminSettingsExist()
        && adminSessionExists()
        && get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.tokenHash
          == get(/databases/$(database)/documents/settings/admin).data.tokenHash;
    }

    match /settings/{documentId} {
      allow read, write: if false;
    }

    match /adminSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid && isAdmin();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && adminSettingsExist()
        && request.resource.data.keys().hasOnly(['tokenHash', 'createdAt'])
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && request.resource.data.tokenHash
          == get(/databases/$(database)/documents/settings/admin).data.tokenHash;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /tournaments/{eventCode} {
      allow get: if isAdmin() || resource.data.isPublic == true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /auditLogs/{logId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
